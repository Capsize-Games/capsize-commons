# Example environment for capsize-commons consumers.
# Copy to .env (gitignored) and adjust. Precedence: env vars > .env > defaults
# (CAPSIZE_PROJECT_STANDARDS.md §7).
#
# Consumed by the opt-in `config` extra (CapsizeSettings, prefix CAPSIZE_)
# and by capsize_commons.logging.configure_logging().
CAPSIZE_LOG_JSON=1
CAPSIZE_LOG_LEVEL=INFO
# CAPSIZE_DATABASE_URL=sqlite:///./app.db
# CAPSIZE_API_KEY=
